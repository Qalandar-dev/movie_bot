# =============================================================================
# Online Store — environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# =============================================================================

# --- General -----------------------------------------------------------------
# development | test | production. docker-compose.prod.yml forces production,
# which enables strict validation (strong secrets, no DEBUG, explicit CORS).
ENVIRONMENT=development
DEBUG=false
PROJECT_NAME=Online Store
TIMEZONE=Asia/Tashkent
LOG_LEVEL=INFO
# true = one JSON object per log line (recommended for production)
LOG_JSON=true

# --- HTTP --------------------------------------------------------------------
# Host port Nginx listens on (the only published port in production).
HTTP_PORT=80
# Public URL of the site, used for payment return URLs and media links.
PUBLIC_BASE_URL=http://localhost
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost,http://localhost:3000
# Comma-separated Host header values accepted by the API ("*" = any; restrict in production).
TRUSTED_HOSTS=*
# Uvicorn worker processes in production.
API_WORKERS=2

# --- PostgreSQL --------------------------------------------------------------
# Used by the postgres container and to build DATABASE_URL inside Docker.
POSTGRES_USER=store
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=online_store
# Only needed when running the backend outside Docker:
# DATABASE_URL=postgresql+asyncpg://store:change-me-postgres-password@localhost:5432/online_store
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10

# --- Redis -------------------------------------------------------------------
# Only needed outside Docker (Compose sets redis://redis:6379/0):
# REDIS_URL=redis://localhost:6379/0

# --- Admin authentication ----------------------------------------------------
# HMAC key for admin JWTs. 32+ random characters; rotating it logs everyone out.
JWT_SECRET_KEY=change-me-generate-a-long-random-value
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
# Max admin login attempts per IP per minute.
RATE_LIMIT_LOGIN_PER_MINUTE=10

# --- Telegram ----------------------------------------------------------------
# Bot token from @BotFather. Leave empty to keep the bot service stopped.
BOT_TOKEN=
# Shared secret the bot sends to the API's customer endpoints (internal network only).
BOT_API_SECRET=change-me-generate-a-different-long-random-value
# Comma-separated Telegram user IDs that receive staff alerts (new orders, low stock).
TELEGRAM_ADMIN_IDS=

# --- Uploads -----------------------------------------------------------------
# local (Docker volume). An S3-compatible backend can be added behind the same interface.
STORAGE_BACKEND=local
MAX_UPLOAD_SIZE_MB=5

# --- Orders ------------------------------------------------------------------
# Unpaid Click/Payme orders release reserved stock after this many minutes.
ORDER_RESERVATION_TTL_MINUTES=30

# --- Payments ----------------------------------------------------------------
# mock    = no provider calls; payments are simulated and flagged as simulated.
# sandbox = provider test environment with test credentials.
# live    = real money. Requires all Click and Payme credentials below.
PAYMENT_MODE=mock

# Click (issued by Click when the merchant account is approved)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=

# Payme (issued in the Payme business cabinet)
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
# Checkout host differs for test and production; confirm it from the official docs.
PAYME_CHECKOUT_URL=
